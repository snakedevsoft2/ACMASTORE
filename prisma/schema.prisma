// ACMA STORE — modelo de datos
// Todos los importes se guardan en centavos (Int) para evitar errores de coma flotante.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Conexión de la aplicación (en Vercel + Neon: la URL con pooling).
  url       = env("DATABASE_URL")
  // Conexión directa para migraciones (en Neon: DATABASE_URL_UNPOOLED). En local es la misma.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────────────────────── Usuarios y autenticación ───────────────────────────

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions       Session[]
  resetTokens    PasswordResetToken[]
  addresses      Address[]
  orders         Order[]
  cart           Cart?
  statusChanges  OrderStatusHistory[]
  inventoryMoves InventoryMovement[]

  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String?
  country    String
  notes      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────── Catálogo ───────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  shortDescription String?
  description      String?       @db.Text
  categoryId       String?
  status           ProductStatus @default(DRAFT)
  // Precio base y precio anterior (tachado) en centavos.
  priceCents       Int
  compareAtCents   Int?
  isFeatured       Boolean       @default(false)
  // Unidades vendidas en pedidos no cancelados. Se usa para "Más vendidos".
  salesCount       Int           @default(0)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  category   Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images     ProductImage[]
  options    ProductOption[]
  variants   ProductVariant[]
  orderItems OrderItem[]

  @@index([status, categoryId])
  @@index([status, createdAt])
  @@index([status, salesCount])
  @@index([status, priceCents])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  width     Int?
  height    Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

// Definición de opciones para el selector (ej. name="Talla", values=["S","M","L"]).
model ProductOption {
  id        String   @id @default(cuid())
  productId String
  name      String
  values    String[]
  sortOrder Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Cada producto tiene al menos una variante. El inventario vive aquí.
model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  // Etiqueta legible ("Rojo / M"); "Predeterminada" para productos sin opciones.
  name           String
  sku            String?  @unique
  // Combinación de opciones: { "Color": "Rojo", "Talla": "M" }.
  options        Json     @default("{}")
  // Si es null se usa el precio del producto.
  priceCents     Int?
  compareAtCents Int?
  stock          Int      @default(0)
  // false = "sin control de inventario": siempre disponible y no descuenta unidades.
  trackStock     Boolean  @default(true)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]
  movements  InventoryMovement[]

  @@index([productId])
  @@index([stock])
}

enum InventoryReason {
  INITIAL
  ADJUSTMENT
  RESTOCK
  ORDER
  ORDER_CANCELLED
}

model InventoryMovement {
  id        String          @id @default(cuid())
  variantId String
  delta     Int
  stockAfter Int
  reason    InventoryReason
  orderId   String?
  userId    String?
  note      String?
  createdAt DateTime        @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([createdAt])
}

// ──────────────────────────────────── Carrito ───────────────────────────────────

model Cart {
  id        String   @id @default(cuid())
  // Hash del token guardado en la cookie del invitado.
  tokenHash String?  @unique
  userId    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

// ──────────────────────────────── Envío, pago, promos ───────────────────────────

model ShippingMethod {
  id            String   @id @default(cuid())
  name          String
  description   String?
  priceCents    Int
  // Envío gratis cuando el subtotal (con descuento) alcanza este valor.
  freeOverCents Int?
  estimatedDays String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]
}

enum PaymentProviderCode {
  STRIPE
  MERCADOPAGO
  BANK_TRANSFER
  CASH_ON_DELIVERY
}

// Solo configuración visible. Las credenciales viven en variables de entorno.
model PaymentMethodConfig {
  id           String              @id @default(cuid())
  provider     PaymentProviderCode @unique
  displayName  String
  description  String?
  // Instrucciones mostradas al cliente (ej. datos bancarios para transferencia).
  instructions String?             @db.Text
  isActive     Boolean             @default(false)
  sortOrder    Int                 @default(0)
  updatedAt    DateTime            @updatedAt
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  description    String?
  type           CouponType
  // PERCENT: 1-100. FIXED: centavos.
  value          Int
  minSubtotalCents Int?
  maxUses        Int?
  usedCount      Int        @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  orders Order[]
}

// ──────────────────────────────────── Pedidos ───────────────────────────────────

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id      String @id @default(cuid())
  // Consecutivo para el número visible ACMA-000001.
  number  Int    @unique @default(autoincrement())
  userId  String?
  // Token aleatorio (hasheado) para que un invitado consulte su pedido.
  accessTokenHash String @unique

  email         String
  customerName  String
  customerPhone String

  shipFullName   String
  shipPhone      String
  shipLine1      String
  shipLine2      String?
  shipCity       String
  shipState      String
  shipPostalCode String?
  shipCountry    String
  shipNotes      String?

  shippingMethodId   String?
  shippingMethodName String
  paymentProvider    PaymentProviderCode
  paymentMethodName  String
  couponId           String?
  couponCode         String?

  currency       String
  subtotalCents  Int
  discountCents  Int
  shippingCents  Int
  totalCents     Int

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  // Referencia externa de la pasarela (session id / preference id).
  paymentReference String?
  paidAt        DateTime?

  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  cancelledAt    DateTime?

  customerNote String?
  adminNote    String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  shippingMethod ShippingMethod?      @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  coupon         Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  history        OrderStatusHistory[]
  transactions   PaymentTransaction[]
  inventoryMoves InventoryMovement[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([email])
  @@index([createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String?
  variantId      String?
  productName    String
  variantName    String?
  sku            String?
  imageUrl       String?
  unitPriceCents Int
  quantity       Int
  totalCents     Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id            String         @id @default(cuid())
  orderId       String
  status        OrderStatus?
  paymentStatus PaymentStatus?
  note          String?
  createdById   String?
  createdAt     DateTime       @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

// Registro de cada evento recibido de la pasarela (auditoría de transacciones).
model PaymentTransaction {
  id          String              @id @default(cuid())
  orderId     String
  provider    PaymentProviderCode
  // Id del evento o pago en la pasarela; evita procesar dos veces el mismo evento.
  externalId  String
  eventType   String
  status      PaymentStatus
  amountCents Int?
  currency    String?
  payload     Json?
  createdAt   DateTime            @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId, eventType])
  @@index([orderId])
}

// ─────────────────────────────── Contenido y ajustes ────────────────────────────

model StoreSettings {
  id             Int      @id @default(1)
  storeName      String   @default("ACMA STORE")
  slogan         String   @default("TODO EN UN SOLO LUGAR")
  logoUrl        String?
  contactEmail   String?
  contactPhone   String?
  whatsapp       String?
  address        String?
  businessHours  String?
  instagramUrl   String?
  facebookUrl    String?
  tiktokUrl      String?
  xUrl           String?
  youtubeUrl     String?
  currency       String   @default("COP")
  locale         String   @default("es-CO")
  country        String   @default("Colombia")
  announcement   String?
  // Modo de venta: true = los clientes piden por WhatsApp (sin cuentas ni pago en línea).
  whatsappOnly   Boolean  @default(true)
  lowStockThreshold Int   @default(5)
  gaMeasurementId   String?
  googleAdsId       String?
  googleAdsPurchaseLabel String?
  // Publicidad en Facebook e Instagram.
  metaPixelId       String?
  // SEO de la página de inicio (si están vacíos se generan automáticamente).
  seoTitle          String?
  seoDescription    String?
  // Códigos de verificación de dominio (Google Search Console / Merchant Center y Meta Business).
  googleSiteVerification     String?
  facebookDomainVerification String?
  updatedAt      DateTime @updatedAt
}

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  // Texto con formato ligero: párrafos, "## Títulos" y listas "- ".
  content     String   @db.Text
  seoDescription String?
  isPublished Boolean  @default(true)
  // false hasta que el administrador lo revise y guarde por primera vez.
  isReviewed  Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  author    String
  location  String?
  content   String
  rating    Int      @default(5)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}
