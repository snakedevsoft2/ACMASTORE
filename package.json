{
  "name": "acma-store",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:import-catalog": "tsx prisma/import-catalog.ts",
    "db:studio": "prisma studio",
    "postinstall": "node scripts/db-env.mjs prisma generate",
    "test:e2e": "node tests/e2e/flujo-compra.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@vercel/blob": "2.9.0",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "lucide-react": "1.73.0",
    "next": "15.5.29",
    "nodemailer": "6.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "stripe": "23.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/nodemailer": "6.4.24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.65.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
