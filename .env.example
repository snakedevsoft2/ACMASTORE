# ───────── Aplicación ─────────
# URL pública del sitio (sin barra final). Se usa en SEO, correos y retornos de pago.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ───────── Base de datos ─────────
# En Vercel + Neon ambas las crea la integración automáticamente (pooling y directa).
DATABASE_URL="postgresql://acma:acma_dev_password@localhost:5433/acma_store?schema=public"
DATABASE_URL_UNPOOLED="postgresql://acma:acma_dev_password@localhost:5433/acma_store?schema=public"

# ───────── Administrador inicial (lo crea `npm run db:seed`) ─────────
ADMIN_EMAIL="admin@tu-dominio.com"
ADMIN_PASSWORD="cambia-esta-contraseña"
ADMIN_NAME="Administrador ACMA"

# ───────── Correo SMTP (recuperación de contraseña y confirmaciones) ─────────
# Si SMTP_HOST está vacío, en desarrollo los correos se imprimen en la consola del servidor.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ACMA STORE <no-reply@tu-dominio.com>"
# Correo que recibe el aviso de pedidos nuevos.
ORDER_NOTIFICATION_EMAIL=""

# ───────── Pasarelas de pago ─────────
# Un método en línea solo se ofrece al cliente si está activo en el admin Y tiene credenciales aquí.
# Stripe: https://dashboard.stripe.com/apikeys  · Webhook → /api/webhooks/stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Mercado Pago: https://www.mercadopago.com/developers/panel · Webhook → /api/webhooks/mercadopago
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# ───────── Tareas programadas ─────────
# Protege /api/cron/expire-orders (cancela pedidos con pago en línea sin completar).
CRON_SECRET=""
# Horas que un pedido con pago en línea puede quedar pendiente antes de liberar el stock.
PENDING_ORDER_TTL_HOURS="24"

# Zona horaria del negocio (agrupa las ventas por día en el dashboard).
STORE_TIMEZONE="America/Bogota"

# ───────── Archivos ─────────
# En Vercel: crea un Blob store (Storage → Blob) y Vercel agrega BLOB_READ_WRITE_TOKEN.
# Si está definido, las fotos van a Vercel Blob; si no, al disco local (UPLOAD_DIR).
BLOB_READ_WRITE_TOKEN=""
UPLOAD_DIR="./storage/uploads"
